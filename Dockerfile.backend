FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY backend/package*.json ./
COPY backend/tsconfig.json ./

# Install dependencies
RUN npm ci

# Copy source code and prisma schema
COPY backend/src ./src
COPY backend/prisma ./prisma

# Generate Prisma Client
RUN npx prisma generate

# Build TypeScript and verify output
RUN npm run build && \
    echo "Build completed. Checking dist folder:" && \
    ls -la && \
    if [ -d "dist" ]; then \
      echo "dist folder exists:" && \
      ls -la dist/; \
    else \
      echo "ERROR: dist folder not found!" && \
      exit 1; \
    fi

# Production stage
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY backend/package*.json ./

# Install production dependencies only
RUN npm ci --only=production

# Copy prisma schema
COPY backend/prisma ./prisma

# Copy built files
COPY --from=builder /app/dist ./dist

# Copy generated Prisma client from builder to the correct location
# The compiled code imports from '../generated/prisma' relative to dist/src/
# So we need generated folder at the same level as dist/src/ (inside dist/)
COPY --from=builder /app/generated ./dist/generated

# Create uploads directory
RUN mkdir -p uploads/inventory

# Expose port
EXPOSE 5000

# Run migrations and start the application
CMD npx prisma migrate deploy && node dist/src/index.js
