# Database Configuration
DATABASE_URL="postgresql://nutrichef:your_secure_password@localhost:5432/nutrichef?schema=public"
DB_NAME=nutrichef
DB_USER=nutrichef
DB_PASSWORD=your_secure_password

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET="your-super-secret-jwt-key-change-me-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-me-in-production"
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=production
BACKEND_URL="https://api.your-domain.com"

# Frontend URL (for CORS)
FRONTEND_URL="https://your-domain.com"
ALLOWED_ORIGINS="https://your-domain.com,https://www.your-domain.com"

# OAuth Configuration
# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Discord OAuth
DISCORD_CLIENT_ID="your_discord_client_id_here"
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"

# Session Settings
SESSION_EXPIRY="7d"
ACCESS_TOKEN_EXPIRY="15m"

# AI Service Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here_optional"

# Encryption Keys for User API Keys
API_KEY_ENCRYPTION_SECRET="your-32-character-secret-key-for-server-encryption"
CLIENT_ENCRYPTION_KEY="your-client-encryption-key-32chars-must-match-frontend"

# File Upload Configuration
UPLOAD_DIR="./uploads/inventory"
MAX_FILE_SIZE=10485760

# Email Configuration (Gmail SMTP)
# Use Gmail App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_EMAIL="your_gmail_address@gmail.com"
SMTP_PASSWORD="your_16_character_app_password_here"

# Custom sender email/name (optional - for custom domain)
# If not set, will use SMTP_EMAIL as sender
SENDER_EMAIL="nutrichef@yourdomain.com"
SENDER_NAME="NutriChef"
