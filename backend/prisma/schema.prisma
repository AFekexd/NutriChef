// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId        String        @id @default(uuid()) @db.Uuid
  name          String
  email         String        @unique
  passwordHash  String
  role          String        @default("user") // "user", "admin"
  preferences   Json?         // {dietaryRestrictions, allergies, cuisinePreferences, calorieGoal, macroGoals}
  healthGoals   Json?         // {targetWeight, dailyCalories, macroRatios, activityLevel}
  isEmailVerified Boolean     @default(false)
  isActive      Boolean       @default(true)
  lastLoginAt   DateTime?
  lastLoginIp   String?
  failedLoginAttempts Int     @default(0)
  lockedUntil   DateTime?
  refreshToken  String?
  inventoryItems InventoryItem[]
  groceryListItems GroceryListItem[]
  recipes       Recipe[]
  mealPlans     MealPlan[]
  consumptionLogs ConsumptionLog[]
  userHealthData UserHealthData[]
  moodLogs      MoodLog[]
  sessions      Session[]
  loginHistory  LoginHistory[]
  aiGeneratedRecipes AIGeneratedRecipe[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Session {
  sessionId     String      @id @default(uuid()) @db.Uuid
  user          User        @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId        String      @db.Uuid
  token         String      @unique
  ipAddress     String
  userAgent     String?
  isValid       Boolean     @default(true)
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([token])
}

model LoginHistory {
  loginHistoryId String      @id @default(uuid()) @db.Uuid
  user          User        @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId        String      @db.Uuid
  ipAddress     String
  userAgent     String?
  success       Boolean
  failureReason String?
  location      String?
  timestamp     DateTime    @default(now())

  @@index([userId])
  @@index([timestamp])
}
model Ingredient {
  ingredientId    String        @id @default(uuid()) @db.Uuid
  name            String
  category        String
  nutritionalInfo Json          // {calories, protein, carbs, fat, fiber, vitamins, minerals}
  carbonFootprint Float
  commonUnits     Json?         // {units: ["g", "kg", "oz", "cup"], conversions: {...}}
  averagePrice    Float?
  inventoryItems  InventoryItem[]
  groceryListItems GroceryListItem[]
  recipeIngredients RecipeIngredient[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model InventoryItem {
  inventoryItemId        String                  @id @default(uuid()) @db.Uuid
  user                   User                    @relation(fields: [userId], references: [userId])
  userId                 String                  @db.Uuid
  ingredient             Ingredient              @relation(fields: [ingredientId], references: [ingredientId])
  ingredientId           String                  @db.Uuid
  quantity               Float
  unit                   String
  expiryDate             DateTime
  consumptionRate        Float?                  // Units per day
  purchaseDate           DateTime?
  location               String?                 // Fridge, Pantry, Freezer
  imageUrl               String?                 // From photo upload
  aiDetected             Boolean                 @default(false) // Was this detected by AI?
  consumptionLogs        ConsumptionLog[]
  mealPlanInventoryItems MealPlanInventoryItem[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model GroceryListItem {
  groceryListItemId String      @id @default(uuid()) @db.Uuid
  user              User        @relation(fields: [userId], references: [userId])
  userId            String      @db.Uuid
  ingredient        Ingredient  @relation(fields: [ingredientId], references: [ingredientId])
  ingredientId      String      @db.Uuid
  plannedQuantity   Float
  unit              String      @default("unit")
  recommendedQuantity Float
  recommendedUnit   String?
  lastPurchasedPrice Float?
  isPurchased       Boolean     @default(false)
  priority          Int         @default(0) // 0=low, 1=medium, 2=high
  source            String?     // "manual", "recipe", "ai_suggested"
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Recipe {
  recipeId         String              @id @default(uuid()) @db.Uuid
  user             User?               @relation(fields: [userId], references: [userId])
  userId           String?             @db.Uuid
  title            String
  instructions     String
  imageURL         String?
  calories         Float
  macros           Json                // {protein, carbs, fat, fiber}
  servings         Int                 @default(1)
  prepTime         Int?                // Minutes
  cookTime         Int?                // Minutes
  difficulty       String?             // "easy", "medium", "hard"
  cuisineType      String?
  dietaryTags      Json?               // ["vegetarian", "gluten-free", etc.]
  isAIGenerated    Boolean             @default(false)
  recipeIngredients RecipeIngredient[]
  mealPlanRecipes  MealPlanRecipe[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model RecipeIngredient {
  recipeIngredientId String      @id @default(uuid()) @db.Uuid
  recipe            Recipe      @relation(fields: [recipeId], references: [recipeId])
  recipeId          String      @db.Uuid
  ingredient       Ingredient   @relation(fields: [ingredientId], references: [ingredientId])
  ingredientId     String      @db.Uuid
  quantity         Float
  unit             String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model MealPlan {
  mealPlanId           String                  @id @default(uuid()) @db.Uuid
  user                 User                    @relation(fields: [userId], references: [userId])
  userId               String                  @db.Uuid
  date                 DateTime
  mealType             String                  // "breakfast", "lunch", "dinner", "snack"
  isAIGenerated        Boolean                 @default(false)
  targetCalories       Float?
  targetMacros         Json?                   // {protein, carbs, fat}
  mealPlanRecipes      MealPlanRecipe[]
  mealPlanInventoryItems MealPlanInventoryItem[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
}

model MealPlanRecipe {
  mealPlanRecipeId String      @id @default(uuid()) @db.Uuid
  mealPlan        MealPlan    @relation(fields: [mealPlanId], references: [mealPlanId], onDelete: Cascade)
  mealPlanId      String      @db.Uuid
  recipe          Recipe      @relation(fields: [recipeId], references: [recipeId])
  recipeId        String      @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model MealPlanInventoryItem {
  mealPlanInventoryItemId String        @id @default(uuid()) @db.Uuid
  mealPlan                MealPlan      @relation(fields: [mealPlanId], references: [mealPlanId], onDelete: Cascade)
  mealPlanId              String        @db.Uuid
  inventoryItem           InventoryItem @relation(fields: [inventoryItemId], references: [inventoryItemId])
  inventoryItemId         String        @db.Uuid
  quantityUsed            Float         @default(1)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model ConsumptionLog {
  consumptionLogId String        @id @default(uuid()) @db.Uuid
  user             User          @relation(fields: [userId], references: [userId])
  userId           String        @db.Uuid
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [inventoryItemId])
  inventoryItemId String        @db.Uuid
  quantityConsumed Float
  dateTime        DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
model UserHealthData {
  healthDataId   String      @id @default(uuid()) @db.Uuid
  user           User        @relation(fields: [userId], references: [userId])
  userId         String      @db.Uuid
  date           DateTime
  caloriesBurned Float
  activityType   String
  heartRate      Int?
  sleepHours     Float?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
model MoodLog {
  moodLogId      String      @id @default(uuid()) @db.Uuid
  user           User        @relation(fields: [userId], references: [userId])
  userId         String      @db.Uuid
  dateTime       DateTime
  moodDescription String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// AI-Generated Recipe Tracking
model AIGeneratedRecipe {
  aiRecipeId      String      @id @default(uuid()) @db.Uuid
  user            User        @relation(fields: [userId], references: [userId])
  userId          String      @db.Uuid
  prompt          String      // User's request
  generatedRecipe Json        // Full AI response
  wasAccepted     Boolean     @default(false)
  recipeId        String?     // If user saved it
  aiModel         String      // "gpt-4", "gemini-pro", etc.
  tokensUsed      Int?
  generationTime  Float?      // Seconds
  createdAt       DateTime    @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

// Portion & Duration Estimation Tracking
model PortionEstimate {
  portionEstimateId String      @id @default(uuid()) @db.Uuid
  inventoryItemId   String      @db.Uuid
  estimatedDuration Int         // Days until depleted
  recommendedPurchaseQty Float
  confidence        Float       // 0-1 confidence score
  algorithm         String      // "time_series", "ml_regression", etc.
  createdAt         DateTime    @default(now())
  
  @@index([inventoryItemId])
}

// Image Upload Tracking for Inventory
model InventoryImageUpload {
  uploadId        String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  imageUrl        String
  detectedItems   Json        // [{name, confidence, quantity_estimate}]
  aiService       String      // "google_vision", "gemini", "yolo"
  processingTime  Float?      // Seconds
  wasAccepted     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

// Nutrition Analysis Cache
model NutritionAnalysis {
  analysisId      String      @id @default(uuid()) @db.Uuid
  itemName        String
  quantity        Float
  unit            String
  nutritionData   Json        // Full nutrition breakdown
  source          String      // "usda", "nutritionix", "ml_model"
  confidence      Float?
  createdAt       DateTime    @default(now())
  
  @@index([itemName])
  @@unique([itemName, quantity, unit])
}

// Health Insights Cache
model HealthInsightsCache {
  cacheId         String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  language        String      @default("en")
  insightsData    Json        // Full health insights response
  expiresAt       DateTime    // Cache expiration time
  createdAt       DateTime    @default(now())
  
  @@index([userId, language])
  @@index([expiresAt])
}

// Recipe Recommendations Cache
model RecipeRecommendationsCache {
  cacheId             String      @id @default(uuid()) @db.Uuid
  userId              String      @db.Uuid
  ingredientsHash     String      // Hash of ingredients used for lookup
  servings            Int
  minMatchPercentage  Int
  language            String      @default("en")
  allergies           Json        // Array of allergies
  recommendations     Json        // Full recommendations response
  expiresAt           DateTime    // Cache expiration time
  createdAt           DateTime    @default(now())
  
  @@index([userId, ingredientsHash])
  @@index([expiresAt])
}
